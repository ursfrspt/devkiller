.DS_Store
.build/
.swiftpm/
dist/
docs/
# 설계 스펙은 추적한다 (docs/ 전체 무시의 예외).
!docs/
docs/*
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/
_workspace/
xcuserdata/
DerivedData/

# 로컬 서명/공증 자료.
# Developer ID 개인 키나 내보낸 인증서는 절대 커밋하지 않는다.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
notary-*.json
notary-log*.json

# 로컬 릴리스 산출물.
*.zip
*.zip.sha256
*.dmg
